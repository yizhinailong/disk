# Copy to .env.distributed and replace every replace-* value.
DISK_JWT_SECRET=replace-with-at-least-32-random-characters
DISK_DATABASE_PASSWORD=replace-database-password
DISK_REDIS_PASSWORD=replace-redis-password
DISK_MINIO_ROOT_USER=disk-local
DISK_MINIO_ROOT_PASSWORD=replace-minio-password
DISK_S3_ACCESS_KEY=disk-app
DISK_S3_SECRET_KEY=replace-s3-application-password

# Optional host ports and per-process connection budgets.
DISK_LB_PORT=18080
DISK_API_A_PORT=18081
DISK_API_B_PORT=18082
DISK_POSTGRES_PORT=15432
DISK_REDIS_PORT=16379
DISK_MINIO_PORT=19000
DISK_MINIO_CONSOLE_PORT=19001
DISK_DATABASE_POOL_SIZE=8
DISK_REDIS_POOL_SIZE=4
DISK_S3_MAX_CONNECTIONS=16
DISK_S3_IO_THREADS=4

# Final topology default. Keep local through the transition release, then switch to s3.
DISK_UPLOAD_STAGING_BACKEND=s3

# Final topology default. Override to false only for the documented observation gate.
DISK_WORKER_CLAIMING_ENABLED=true
