{
  "schema_version": 1,
  "name": "disk-kubernetes-compatible-rollout",
  "minimum_kubernetes_version": "1.30",
  "namespace": "disk",
  "artifacts": {
    "platform": "deploy/kubernetes/platform",
    "migration": "deploy/kubernetes/migration",
    "worker": "deploy/kubernetes/workloads/worker",
    "api": "deploy/kubernetes/workloads/api",
    "steady_state": "deploy/kubernetes/workloads"
  },
  "image_policy": {
    "name": "disk-backend",
    "require_digest": true,
    "forbid_tags_in_rendered_candidate": true
  },
  "secret_policy": {
    "manifest_committed": false,
    "runtime_secret_name": "disk-runtime-secrets",
    "required_keys": [
      "DATABASE_PASSWORD",
      "REDIS_PASSWORD",
      "JWT_SECRET",
      "DISK_S3_ACCESS_KEY",
      "DISK_S3_SECRET_KEY"
    ],
    "optional_keys": [
      "DISK_S3_SESSION_TOKEN"
    ]
  },
  "capacity_gate": {
    "checker": "scripts/check-distributed-capacity.py",
    "config": "deploy/config.distributed.json",
    "required_topologies": [
      "steady=2:2",
      "maximum=4:4"
    ],
    "rolling_replacement_reserve_processes": 1,
    "scheduling": {
      "minimum_eligible_nodes": 5,
      "minimum_failure_domains": 2,
      "topology_key": "topology.kubernetes.io/zone",
      "reason": "same_role_hard_anti_affinity_with_max_replicas_plus_surge"
    },
    "budgets_must_come_from_target_environment": [
      "postgresql_connections",
      "redis_connections",
      "s3_http_connections",
      "s3_io_threads"
    ]
  },
  "stages": [
    {
      "order": 1,
      "id": "preflight_and_capacity",
      "actions": [
        "render_platform_migration_and_workloads",
        "reject_placeholders_secrets_and_non_digest_images",
        "server_side_dry_run_all_resources",
        "verify_scheduler_capacity",
        "pass_capacity_gate",
        "apply_platform_resources"
      ],
      "stop_on_failure": true
    },
    {
      "order": 2,
      "id": "expand_migration",
      "actions": [
        "require_unique_release_name_suffix",
        "create_exactly_one_release_scoped_job",
        "wait_for_job_complete",
        "archive_job_logs",
        "verify_schema_migrations_versions_and_checksums"
      ],
      "stop_on_failure": true
    },
    {
      "order": 3,
      "id": "worker_rollout",
      "actions": [
        "apply_worker_resources_only",
        "wait_for_worker_rollout",
        "verify_two_ready_workers",
        "verify_worker_hpa_metrics",
        "verify_claim_and_lease_progress"
      ],
      "stop_on_failure": true
    },
    {
      "order": 4,
      "id": "api_rollout",
      "actions": [
        "apply_api_resources_only",
        "wait_for_api_rollout",
        "verify_two_ready_api_pods",
        "verify_api_hpa_metrics"
      ],
      "stop_on_failure": true
    },
    {
      "order": 5,
      "id": "post_rollout_gate",
      "actions": [
        "verify_service_has_no_session_affinity",
        "verify_cross_instance_upload_and_download",
        "verify_zero_quota_residual",
        "verify_zero_unresolved_reconciliation_findings"
      ],
      "stop_on_failure": true
    }
  ],
  "rollback": {
    "freeze_upload_task_creation_first": true,
    "application_order": [
      "api",
      "worker"
    ],
    "wait_for_each_role_to_drain": true,
    "schema_action": "preserve_expand",
    "automatic_destructive_migration": false
  }
}
