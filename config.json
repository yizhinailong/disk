{
  "listeners": [
    {
      "address": "127.0.0.1",
      "port": 8080
    }
  ],
  "app": {
    "upload_path": "build/uploaded",
    "storage_base_path": "build/uploaded",
    "temp_upload_path": "build/temp_uploads",
    "chunk_size": 5242880,
    "max_file_size": 10737418240,
    "upload_task_expiry_seconds": 86400,
    "threads_num": 0
  },
  "db_clients": [
    {
      "name": "default",
      "rdbms": "mysql",
      "host": "127.0.0.1",
      "port": 3306,
      "dbname": "disk",
      "user": "root",
      "passwd": "mysql",
      "num_connection_number": 10
    }
  ],
  "redis_clients": [
    {
      "name": "default",
      "host": "47.97.231.191",
      "port": 6379,
      "passwd": "redis",
      "db": 0,
      "is_fast": false,
      "number_of_connections": 10,
      "timeout": 5.0
    }
  ],
  "plugins": [
    {
      "name": "drogon::plugin::GlobalFilters",
      "config": {
        "filters": [
          "disk::filters::JwtAuthFilter",
          "disk::filters::RateLimitFilter"
        ],
        "exempt": [
          "^/api/auth/register",
          "^/api/auth/login",
          "^/api/share/access/.*",
          "^/api/share-browse/.*",
          "^/api/share/download/.*"
        ]
      }
    },
    {
      "name": "drogon::plugin::AccessLogger",
      "config": {
        "log_path": "",
        "log_file": "log",
        "log_level": "DEBUG",
        "log_size_limit": 10485760,
        "max_files": 10,
        "use_spdlog": true,
        "log_format": "[$request_date] [$thread] ($remote_addr) \"$request\" $status $body_bytes_sent $processing_time"
      }
    }
  ]
}
