{
  "listeners": [
    {
      "address": "127.0.0.1",
      "port": 8080
    }
  ],
  "app": {
    "upload_path": "build/uploaded"
  },
  "db_clients": [
    {
      "name": "default",
      "rdbms": "mysql",
      "host": "127.0.0.1",
      "port": 3306,
      "dbname": "disk",
      "user": "root",
      "passwd": "mysql",
      "num_connection_number": 1
    }
  ],
  "plugins": [
    {
      "name": "drogon::plugin::AccessLogger",
      "config": {
        "log_path": "",
        "log_file": "log",
        "log_level": "DEBUG",
        "log_size_limit": 10485760,
        "max_files": 10,
        "use_spdlog": true,
        "log_format": "[$request_date] [$thread] ($remote_addr) \"$request\" $status $body_bytes_sent $processing_time"
      }
    }
  ]
}
