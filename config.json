{
  "client_max_body_size": "20M",
  "listeners": [
    {
      "address": "127.0.0.1",
      "port": 8080
    }
  ],
  "app": {
    "upload_path": "build/uploaded",
    "threads_num": 0
  },
  "custom_config": {
    "disk": {
      "storage_base_path": "build/uploaded",
      "temp_upload_path": "build/temp_uploads",
      "chunk_size": 5242880,
        "max_file_size": 10737418240,
        "upload_task_expiry_seconds": 86400,
        "upload_rate_limit_per_minute": 240,
        "assembly_max_concurrent": 4,
        "assemble_buffer_size_bytes": 262144
    }
  },
  "db_clients": [
    {
      "name": "default",
      "rdbms": "mysql",
      "host": "127.0.0.1",
      "port": 3306,
      "dbname": "disk",
      "user": "root",
      "passwd": "mysql",
      "num_connection_number": 10
    }
  ],
  "redis_clients": [
    {
      "name": "default",
      "host": "127.0.0.1",
      "port": 6379,
      "db": 0,
      "is_fast": false,
      "number_of_connections": 10,
      "timeout": 5.0
    }
  ],
  "plugins": [
    {
      "name": "drogon::plugin::GlobalFilters",
      "config": {
        "filters": [
          "disk::filters::JwtAuthFilter"
        ],
        "exempt": [
          "^/api/auth/register",
          "^/api/auth/login",
          "^/api/auth/refresh",
          "^/api/health",
          "^/api/share/access/.*",
          "^/api/share/browse/.*",
          "^/api/share/download/.*"
        ]
      }
    },
    {
      "name": "drogon::plugin::AccessLogger",
      "config": {
        "log_path": "",
        "log_file": "log",
        "log_level": "INFO",
        "log_size_limit": 10485760,
        "max_files": 10,
        "use_spdlog": true,
        "log_format": "[$request_date] [$thread] ($remote_addr) \"$request\" $status $body_bytes_sent $processing_time"
      }
    }
  ]
}
